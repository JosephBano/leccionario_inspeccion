{
  "_comentario": [
    "PLANTILLA de appsettings.Development.json. NO es para producción ni para commitear.",
    "",
    "Pasos para configurar tu entorno local:",
    "  1. cp appsettings.Development.example.json appsettings.Development.json",
    "  2. Reemplazar los placeholders <…> por valores reales.",
    "  3. Generar un secreto JWT propio:",
    "       openssl rand -base64 32",
    "  4. appsettings.Development.json está en .gitignore — no se commitea.",
    "",
    "Para producción, NO usar este archivo. Usar variables de entorno:",
    "  ConnectionStrings__SigafiDb, JWTSettings__Secret, etc. Ver docs/09."
  ],

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "leccionario-cplec": "Debug"
    }
  },

  "ConnectionStrings": {
    "SigafiDb": "Server=<host>;Port=3306;Database=sigafi_es;User=<user>;Password=<password>"
  },

  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:4200"
  ],

  "SistemaCodigo": "cplec",

  "JWTSettings": {
    "Secret": "<reemplazar con `openssl rand -base64 32`>",
    "Issuer": "leccionario_conduccion",
    "Audience": "cplec",
    "ExpiryHours": 24
  },

  "Leccionario": {
    "VentanaEdicionHoras": 72,
    "IdCarreraConduccion": 6,
    "PageSizeMaximo": 200
  },

  "RateLimiting": {
    "LoginIntentosPorVentana": 5,
    "LoginVentanaMinutos": 5,
    "ReportesPorMinuto": 10,
    "GeneralPorMinuto": 120
  },

  "Reportes": {
    "TemplatesPath": "Storage/Templates",
    "SalidaPath": "Storage/Generated",
    "MaxFilasPorReporte": 20000
  }
}
